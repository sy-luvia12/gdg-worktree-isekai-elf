{
  "expo": {
    "name": "isekai-elf",
    "slug": "isekai-elf",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "isekaielf",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "식물을 촬영하려면 카메라 권한이 필요해요.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
